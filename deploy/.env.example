# Copy to the repository root as .env. Keep it private and out of Git.
# Replace with the exact browser origin; include the port when it is not 80.
INFORADAR_SERVER_FRONTEND_URL=http://203.0.113.10
INFORADAR_HTTP_PORT=80
INFORADAR_IMAGE_TAG=local

# Generate four independent values with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
INFORADAR_DATABASE_PASSWORD=
INFORADAR_AUTH_JWT_SECRET=
INFORADAR_RADAR_ENCRYPTION_KEY=

# Optional, only for password reset emails. Leave HOST empty to disable.
# Registration, login and radar scanning do not require SMTP.
# When enabling, use the provider's settings and authorization password.
# 465 -> implicit TLS; 587 -> starttls. Quote passwords containing $ or #.
INFORADAR_SMTP_HOST=
INFORADAR_SMTP_PORT=465
INFORADAR_SMTP_USERNAME=
INFORADAR_SMTP_PASSWORD=
INFORADAR_SMTP_FROM=
INFORADAR_SMTP_TLS_MODE=implicit

# Keep the proxy IP inside this subnet. Change both if an existing route overlaps.
INFORADAR_DOCKER_SUBNET=172.30.90.0/24
INFORADAR_PROXY_IP=172.30.90.10
